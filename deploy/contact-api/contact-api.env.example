# Copy to /etc/contact-api.env (root:root, 0600). NEVER commit the real file.
# Easiest way to create it: sudo bash deploy/set-credentials.sh

MAIL_TRANSPORT=graph

# Microsoft Graph — Entra app registration with APPLICATION permission Mail.Send
# (admin consent granted). Restrict it to one mailbox with an ApplicationAccessPolicy.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=the-secret-VALUE-not-its-id
GRAPH_SENDER=ops@corazon-tech.com

MAIL_TO=ops@corazon-tech.com
ALLOWED_ORIGIN=https://corazon-tech.com

# Alternative transport, if Graph is ever unavailable:
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=ops@corazon-tech.com
# SMTP_PASS=app-password
